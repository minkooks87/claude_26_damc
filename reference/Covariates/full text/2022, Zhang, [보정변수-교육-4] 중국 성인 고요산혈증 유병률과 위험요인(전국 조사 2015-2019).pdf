<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="3.1-701">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Producer>Acrobat Distiller 7.0 (Windows)</pdf:Producer>
         <pdf:Keywords>hypeuricemia, prevalence, trends, Chinese, gout</pdf:Keywords>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xap="http://ns.adobe.com/xap/1.0/">
         <xap:ModifyDate>2022-02-02T16:24:51+08:00</xap:ModifyDate>
         <xap:CreateDate>2022-02-02T15:17:10+08:00</xap:CreateDate>
         <xap:CreatorTool>Arbortext Advanced Print Publisher 10.0.1306/W Unicode</xap:CreatorTool>
         <xap:MetadataDate>2022-02-02T16:24:51+08:00</xap:MetadataDate>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Objective: To determine the nationwide prevalence of hyperuricemia in China and evaluate its trends and associated risk factors</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Prevalence of Hyperuricemia Among Chinese Adults: Findings From Two Nationally Representative Cross-Sectional Surveys in 2015&amp;ndash;16 and 2018&amp;ndash;19</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Mei Zhang; Xiaoxia Zhu; Jing Wu; Zhengjing Huang; Zhenping Zhao; Xiao Zhang; Yu Xue; Weiguo Wan; Chun Li; Wenrong Zhang; Linhong Wang; Maigeng Zhou; Hejian Zou; Limin Wang</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
